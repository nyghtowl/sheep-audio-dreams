# Required for both demos: Lyra's REST audio and Realtime voice.
OPENAI_API_KEY=

# Required for streaming; primary Zara dialogue provider in REST.
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional, REST only: DM narration and Zara's dialogue fallback.
ANTHROPIC_API_KEY=

# Optional, REST only: alternative Zara TTS.
ELEVENLABS_API_KEY=

# Optional, REST only: force Google TTS for fallback voice paths.
# USE_GTTS=1

# Optional, REST only: use ElevenLabs for fallback voice paths.
# USE_ELEVENLABS_FOR_ALL_VOICES=1

# Optional, REST only: scripted lines + silent audio, with no API calls.
# MOCK_MODE=1

# Provider model IDs are documented in README.md and configured in each
# demo's config.py. Preview model migrations can require protocol changes, so
# they are intentionally not exposed as drop-in environment overrides.
